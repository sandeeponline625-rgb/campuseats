<?xml version="1.0" encoding="UTF-8"?>
<definitions name="PaymentGateway"
    targetNamespace="http://partner.unipay.com/paymentgateway/wsdl"
    xmlns:tns="http://partner.unipay.com/paymentgateway/wsdl"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- 1. Types -->
  <types>
    <xsd:schema targetNamespace="http://partner.unipay.com/paymentgateway/wsdl">
      <xsd:element name="ChargeRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="orderID" type="xsd:string"/>
            <xsd:element name="amount" type="xsd:decimal"/>
            <xsd:element name="method" type="xsd:string"/>
            <xsd:element name="cardNumber" type="xsd:string"/>
            <xsd:element name="expiryDate" type="xsd:string"/>
            <xsd:element name="cvv" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ChargeResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="paymentID" type="xsd:string"/>
            <xsd:element name="status" type="xsd:string"/>
            <xsd:element name="message" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <!-- 2. Messages -->
  <message name="ChargeRequestMessage">
    <part name="parameters" element="tns:ChargeRequest"/>
  </message>
  <message name="ChargeResponseMessage">
    <part name="parameters" element="tns:ChargeResponse"/>
  </message>

  <!-- 3. PortType -->
  <portType name="PaymentPortType">
    <operation name="chargePayment">
      <input message="tns:ChargeRequestMessage"/>
      <output message="tns:ChargeResponseMessage"/>
    </operation>
  </portType>

  <!-- 4. Binding -->
  <binding name="PaymentBinding" type="tns:PaymentPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="chargePayment">
      <soap:operation soapAction="http://partner.unipay.com/paymentgateway/chargePayment"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>
  </binding>

  <!-- 5. Service + Port -->
  <service name="PaymentService">
    <port name="PaymentPort" binding="tns:PaymentBinding">
      <soap:address location="http://partner.unipay.com/paymentgateway"/>
    </port>
  </service>
</definitions>
